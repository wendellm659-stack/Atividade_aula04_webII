generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Authors {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  books Books[]

  @@map("authors")
}

model Books {
  id        String   @id @default(uuid())
  title     String
  pages     Int
  createdAt DateTime @default(now())

  author    Authors @relation(fields: [author_id], references: [id])
  author_id String

  @@map("books")
}
